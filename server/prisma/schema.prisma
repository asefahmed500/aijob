generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String
  systemRole   String        @default("USER")
  createdAt    DateTime      @default(now())
  applications Application[]
  memberships  Membership[]
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  jobs        JobPost[]
  candidates  Candidate[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("RECRUITER")
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model JobPost {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String
  requirements   String
  status         String                 @default("open")
  publicToken    String?
  source         String                 @default("manual")
  createdAt      DateTime               @default(now())
  applications   CandidateApplication[]

  @@index([organizationId])
}

model Candidate {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String
  resumeText     String
  source         String                 @default("manual")
  createdAt      DateTime               @default(now())
  applications   CandidateApplication[]
  cvs            CandidateCv[]

  @@index([organizationId])
}

model CandidateCv {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  headline    String
  summary     String
  skills      String
  experience  String
  education   String
  content     String
  source      String    @default("deterministic")
  model       String
  version     Int       @default(1)
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

model CandidateApplication {
  id          String           @id @default(cuid())
  jobId       String
  job         JobPost          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      String           @default("new")
  stage       String           @default("new")
  rating      Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime?
  scores      CandidateScore[]
  notes       CandidateNote[]
  activities  ActivityEvent[]
  notifications NotificationLog[]

  @@unique([jobId, candidateId])
  @@index([stage])
}

model CandidateNote {
  id            String               @id @default(cuid())
  applicationId String
  application   CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  body          String
  createdAt     DateTime             @default(now())

  @@index([applicationId])
}

model ActivityEvent {
  id             String               @id @default(cuid())
  organizationId String
  applicationId  String?
  application    CandidateApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId        String
  type           String
  message        String
  createdAt      DateTime             @default(now())

  @@index([organizationId])
  @@index([applicationId])
}

model CandidateScore {
  id            String               @id @default(cuid())
  applicationId String
  application   CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  score         Int
  summary       String
  model         String
  source        String
  rawResponse   String?
  createdAt     DateTime             @default(now())
  evidences     ScoreEvidence[]

  @@index([applicationId])
}

model ScoreEvidence {
  id          String         @id @default(cuid())
  scoreId     String
  score       CandidateScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  requirement String
  quote       String
  charStart   Int
  charEnd     Int
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String   @default("RECRUITER")
  token          String   @unique @default(cuid())
  status         String   @default("pending")
  invitedById    String
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([email])
}

model NotificationLog {
  id             String               @id @default(cuid())
  organizationId String
  applicationId  String?
  application    CandidateApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recipient      String
  subject        String
  body           String
  status         String               @default("queued")
  createdAt      DateTime             @default(now())

  @@index([organizationId])
  @@index([applicationId])
}

model Application {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  role        String
  status      String        @default("draft")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  emails      EmailSource[]
  evidence    Evidence[]
  letters     CoverLetter[]
  exports     ExportLog[]

  @@index([userId])
}

model EmailSource {
  id             String    @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subject        String?
  fromAddress    String?
  receivedAt     DateTime?
  rawBody        String
  normalizedBody String
  createdAt      DateTime  @default(now())
  evidence       Evidence[]

  @@index([applicationId])
}

model Evidence {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  emailSourceId String
  emailSource   EmailSource @relation(fields: [emailSourceId], references: [id], onDelete: Cascade)
  kind          String
  claim         String
  verbatimQuote String
  charStart     Int
  charEnd       Int
  confidence    Float       @default(0.7)
  approved      Boolean     @default(false)
  source        String      @default("zai")
  rawResponse   String?
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@index([emailSourceId])
}

model CoverLetter {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  content       String
  model         String
  promptVersion String
  source        String      @default("zai")
  rawResponse   String?
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  claims        LetterClaim[]
  exports       ExportLog[]

  @@index([applicationId])
}

model LetterClaim {
  id         String      @id @default(cuid())
  letterId   String
  letter     CoverLetter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  sentence   String
  evidenceId String?
  grounded   Boolean
  note       String?

  @@index([letterId])
}

model ExportLog {
  id            String      @id @default(cuid())
  letterId      String
  letter        CoverLetter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  format        String
  recipient     String?
  status        String
  createdAt     DateTime    @default(now())

  @@index([letterId])
}
